#!/bin/bash
# kmux-run — run a command outside the agent sandbox, then paste its exit code
# and output tail into the agent's tmux session.
#
# A sandboxed agent cannot reach docker, ssh or the tmux socket. It asks you to
# paste a kmux-run line into an unsandboxed terminal; the result comes back to
# the agent as a prompt message. The full log stays in /tmp/kmux-run/, which the
# sandbox can read.
#
# Usage: kmux-run <id> <command...>
#   <id>  tmux session of the agent: 7, '$7' or any tmux target
#   one <command> argument runs as a shell line; several run as an argv
#   The command runs in the agent pane's current directory.
#   KMUX_LINES sets how many output lines to paste (default 60).
#
# Ctrl-C stops the command but still pastes the result.

set -u

die() { echo "kmux-run: $*" >&2; exit 2; }

[ "${1:-}" = -h ] && { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0; }
[ $# -ge 2 ] || die "usage: kmux-run <id> <command...>"
target=$1; shift
[[ $target =~ ^[0-9]+$ ]] && target="\$$target"
lines=${KMUX_LINES:-60}
tmux has-session -t "$target" 2>/dev/null || die "no tmux session '$target'"
dir=$(tmux display -p -t "$target" '#{pane_current_path}')
cd "$dir" || die "cannot cd to $dir"

# One argument is a shell line; several are an argv, run as-is.
if [ $# -eq 1 ]; then
  cmd=$1
  run() { bash -c "$cmd"; }
else
  cmd=$(printf '%q ' "$@"); cmd=${cmd% }
  run() { "$@"; }
fi
# Show any .sh/.py script the command names, then ask before running it.
scripts=$(grep -oE "[^[:space:]'\"=;&|()<>]+\.(sh|py)\b" <<<"$cmd" | sort -u)
if [ -n "$scripts" ]; then
  while IFS= read -r f; do
    f=${f/#\~/$HOME}
    [ -f "$f" ] && { echo "=== $f ==="; cat -- "$f"; echo; }
  done <<<"$scripts"
  read -rp "Run \`$cmd\`? [y/N] " ans </dev/tty
  [[ $ans =~ ^[yY]$ ]] || die "aborted"
fi

mkdir -p /tmp/kmux-run
log=$(mktemp /tmp/kmux-run/XXXXXXXX.log)

echo "+ $cmd"
trap : INT
run "$@" 2>&1 | tee -i "$log"
rc=${PIPESTATUS[0]}
trap - INT

total=$(wc -l < "$log")
# Drop ANSI escapes and keep only the last redraw of \r progress lines.
tail_text=$(sed -e 's/\x1b\[[0-9;?]*[[:alpha:]]//g' -e 's/.*\r//' "$log" | tail -n "$lines")

if [ "$total" -gt "$lines" ]; then
  head_text="Full log: $log ($total lines). Last $lines lines:"
else
  head_text="Output:"
  rm -f -- "$log"
fi

msg="kmux-run: \`$cmd\` in $dir exited $rc.
$head_text
\`\`\`
$tail_text
\`\`\`"

printf '%s' "$msg" | tmux load-buffer -b kmux-run -
tmux paste-buffer -p -d -b kmux-run -t "$target"
sleep 0.3
tmux send-keys -t "$target" Enter
echo "kmux-run: exit $rc, pasted into $target"
exit "$rc"
