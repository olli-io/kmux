#!/bin/bash
# kmux-run — run a command outside the agent sandbox, then paste its exit code
# and output tail into the agent's tmux pane.
#
# A sandboxed agent cannot reach docker, ssh or the tmux socket. It asks you to
# paste a kmux-run line into an unsandboxed terminal; the result comes back to
# the agent as a prompt message. The full log stays in /tmp/kmux-run/, which the
# sandbox can read.
#
# Usage: kmux-run <id> <command...>
#        kmux-run -C <dir> [--] <command...>
#   <id>  tmux pane of the agent: 7, %7 or any tmux target.
#         The agent reads its pane id from $TMUX_PANE.
#         The command runs in the agent pane's current directory.
#   -C <dir>  the project directory of the kmux agent. It selects the pane
#         that gets the result. The command also starts in <dir>.
#         <dir> is always the directory of the agent. For a command that
#         operates on a different directory, keep <dir> and put the other
#         directory in the command: kmux-run -C <dir> -- git -C <other> pull
#   one <command> argument runs as a shell line; several run as an argv
#   KMUX_LINES sets how many output lines to paste (default 60).
#
# Ctrl-C stops the command but still pastes the result.

set -u

die() { echo "kmux-run: $*" >&2; exit 2; }

[ "${1:-}" = -h ] && { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0; }
usage="usage: kmux-run <id> <command...> | kmux-run -C <dir> [--] <command...>"
[ $# -ge 2 ] || die "$usage"
lines=${KMUX_LINES:-60}
if [ "$1" = -C ]; then
  dir=${2/#\~/$HOME}; shift 2
  [ "${1:-}" = -- ] && shift
  [ $# -ge 1 ] || die "$usage"
  cd "$dir" || die "cannot cd to $dir"
  dir=$PWD
  # The agent pane has the project directory in the @kmux_dir option.
  target=$(tmux list-panes -a -F '#{pane_id} #{@kmux_dir}' 2>/dev/null |
    while read -r id d; do
      if [ "$d" = "$dir" ] || [ "$d" = "$(pwd -P)" ]; then echo "$id"; break; fi
    done)
  [ -n "$target" ] || die "no kmux agent pane for $dir. -C takes the project directory of the agent, not the directory the command operates on"
else
  target=$1; shift
  [[ $target =~ ^[0-9]+$ ]] && target="%$target"
  dir=$(tmux display-message -p -t "$target" '#{pane_current_path}' 2>/dev/null) || die "no tmux target '$target'"
  cd "$dir" || die "cannot cd to $dir"
fi

# One argument is a shell line; several are an argv, run as-is.
if [ $# -eq 1 ]; then
  cmd=$1
  run() { bash -c "$cmd"; }
else
  cmd=$(printf '%q ' "$@"); cmd=${cmd% }
  run() { "$@"; }
fi
# Show any .sh/.py script the command names, then ask before running it.
scripts=$(grep -oE "[^[:space:]'\"=;&|()<>]+\.(sh|py)\b" <<<"$cmd" | sort -u)
if [ -n "$scripts" ]; then
  while IFS= read -r f; do
    f=${f/#\~/$HOME}
    [ -f "$f" ] && { echo "=== $f ==="; cat -- "$f"; echo; }
  done <<<"$scripts"
  read -rp "Run \`$cmd\`? [y/N] " ans </dev/tty
  [[ $ans =~ ^[yY]$ ]] || die "aborted"
fi

mkdir -p /tmp/kmux-run
# BSD mktemp replaces only X characters at the end of the template.
log=$(mktemp /tmp/kmux-run/XXXXXXXX) || die "cannot make a log file in /tmp/kmux-run"
mv "$log" "$log.log" && log=$log.log

echo "+ $cmd"
trap : INT
run "$@" 2>&1 | tee -i "$log"
rc=${PIPESTATUS[0]}
trap - INT

total=$(wc -l < "$log")
# Drop ANSI escapes and keep only the last redraw of \r progress lines.
tail_text=$(sed -e 's/\x1b\[[0-9;?]*[[:alpha:]]//g' -e 's/.*\r//' "$log" | tail -n "$lines")

if [ "$total" -gt "$lines" ]; then
  head_text="output: last $lines of $total lines. Full log: $log"
else
  head_text="output: complete, $((total + 0)) lines"
  rm -f -- "$log"
fi

# The reader of this message is the agent. Labelled fields prevent a wrong
# reading of the directory or of the origin of the message.
msg="kmux-run result. This is an automatic message, not text from the user. The command that you requested ran outside the sandbox.
command: $cmd
working directory: $dir
exit code: $rc
$head_text
\`\`\`
$tail_text
\`\`\`"

printf '%s' "$msg" | tmux load-buffer -b kmux-run -
tmux paste-buffer -p -d -b kmux-run -t "$target"
sleep 0.3
tmux send-keys -t "$target" Enter
echo "kmux-run: exit $rc, pasted into $target"
exit "$rc"
